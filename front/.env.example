# Application
NEXT_PUBLIC_APP_NAME=Minisource Auth
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_APP_VERSION=1.0.0

# Auth Backend API
NEXT_PUBLIC_AUTH_API_BASE_URL=http://127.0.0.1:9001/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Feature Flags
NEXT_PUBLIC_AUTH_ENABLE_GOOGLE=true
NEXT_PUBLIC_AUTH_ENABLE_REGISTER=true
NEXT_PUBLIC_AUTH_ENABLE_OTP=true
NEXT_PUBLIC_AUTH_TOKEN_STORAGE=localStorage

# Analytics / PWA (disabled)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PWA=false
