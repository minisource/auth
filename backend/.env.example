# Auth Service Environment Configuration

# Server
SERVER_PORT=9001
SERVER_MODE=development
SERVER_NAME=auth-service

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100
DB_CONN_MAX_LIFETIME=1h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
# ===========================================
# For production: use RS256 with RSA key pair.
# For development: HS256 with JWT_SECRET works out of the box.
#
# To use RS256/JWKS (required for JWKS-based validation):
#   1. Run: cd scripts && go run genkeys.go
#      (generates config/keys/jwt_private.pem and jwt_public.pem)
#   2. Set JWT_ALGORITHM=RS256
#   3. Set JWT_PRIVATE_KEY_PATH and JWT_PUBLIC_KEY_PATH
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h
JWT_ISSUER=minisource-auth
JWT_AUDIENCE=minisource
JWT_ALGORITHM=RS256
JWT_KEY_ID=auth-key-1

# RSA key paths (required for RS256)
JWT_PRIVATE_KEY_PATH=config/keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=config/keys/jwt_public.pem

# Only set this to true if you understand the security implications
AUTH_ALLOW_HS256_IN_PRODUCTION=false

# OTP Configuration
OTP_LENGTH=4
OTP_EXPIRY=2m
OTP_MAX_ATTEMPTS=5

# Password Configuration
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# Google OAuth2 (TODO: Configure)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:9001/api/v1/auth/google/callback

# CORS
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=debug
LOG_OUTPUT=stdout
LOG_FORMAT=json

# Notifier Integration (Optional — for sending OTP via SMS/Email)
# Note: These values can also be configured dynamically in the Auth Admin UI under System Settings -> Notifier Integration
NOTIFIER_ENABLED=true                          # Optional: Set to false to disable external notification delivery (Default: true)
NOTIFIER_HTTP_URL=http://localhost:9002         # Optional: Notifier HTTP API base URL (Default: http://localhost:9002)
NOTIFIER_GRPC_ADDRESS=localhost:9003           # Optional: Notifier gRPC server address (Default: localhost:9003)
NOTIFIER_CLIENT_ID=auth-service                # Optional: Service client ID for Notifier auth (Default: auth-service)
NOTIFIER_CLIENT_SECRET=auth-service-secret     # Optional: Service client secret for Notifier auth
# NOTIFIER_AUTH_URL=http://localhost:9001      # Optional override URL for token auth requests

# gRPC Server
GRPC_ENABLED=true
GRPC_PORT=9004

# Tracing (OpenTelemetry + OTLP)
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=auth-service
TRACING_SERVICE_NAME=auth-service

# Observability HTTP access log (go-common middleware)
# Body capture is DISABLED by default. Enable only temporarily and never in
# production without a retention/redaction review — captured bodies may contain
# personal data even after redaction.
# OBSERVABILITY_HTTP_LOGGING_ENABLED=true
# OBSERVABILITY_CAPTURE_REQUEST_BODY=false
# OBSERVABILITY_CAPTURE_RESPONSE_BODY=false
# OBSERVABILITY_MAX_BODY_SIZE_BYTES=8192
# OBSERVABILITY_ALLOWED_CONTENT_TYPES=application/json

# Sysadmin Credentials (seeded on startup if set)
SYSADMIN_EMAIL=admin@example.com
SYSADMIN_PASSWORD=changeme123

# ====================================
# Service OAuth Client Credentials
# ====================================
SERVICE_AUTH_CLIENT_ID=auth-service
SERVICE_AUTH_CLIENT_SECRET=auth-service-secret-key

SERVICE_NOTIFIER_CLIENT_ID=notifier-service
SERVICE_NOTIFIER_CLIENT_SECRET=notifier-service-secret-key

SERVICE_GATEWAY_CLIENT_ID=gateway-service
SERVICE_GATEWAY_CLIENT_SECRET=gateway-service-secret-key

SERVICE_LOG_CLIENT_ID=log-service
SERVICE_LOG_CLIENT_SECRET=log-service-secret-key

SERVICE_SCHEDULER_CLIENT_ID=scheduler-service
SERVICE_SCHEDULER_CLIENT_SECRET=scheduler-service-secret-key

SERVICE_STORAGE_CLIENT_ID=storage-service
SERVICE_STORAGE_CLIENT_SECRET=storage-service-secret-key

SERVICE_COMMENT_CLIENT_ID=comment-service
SERVICE_COMMENT_CLIENT_SECRET=comment-service-secret-key

SERVICE_FEEDBACK_CLIENT_ID=feedback-service
SERVICE_FEEDBACK_CLIENT_SECRET=feedback-service-secret-key

SERVICE_TICKET_CLIENT_ID=ticket-service
SERVICE_TICKET_CLIENT_SECRET=ticket-service-secret-key

SERVICE_PAYMENT_CLIENT_ID=payment-service
SERVICE_PAYMENT_CLIENT_SECRET=payment-service-secret-key
# WebAuthn (passkeys)
WEBAUTHN_ENABLED=true
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DiviPay
WEBAUTHN_RP_ORIGINS=http://localhost:3000,http://localhost:3001
WEBAUTHN_CHALLENGE_TTL=5m
